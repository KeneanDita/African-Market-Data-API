# Base URL of the REST API (no trailing slash). Includes the /v1 prefix.
NEXT_PUBLIC_API_URL=http://localhost:8000/v1
# GraphQL endpoint
NEXT_PUBLIC_GRAPHQL_URL=http://localhost:8000/graphql
# Optional: proxy /api/* to the backend during local dev (avoids CORS config)
API_PROXY_TARGET=http://localhost:8000

# Support form: server-only settings (never prefix these with NEXT_PUBLIC_).
# Add these to frontend/.env.local or your frontend hosting environment, then restart.
# Gmail requires 2-Step Verification and an App Password, not your account password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=Keneansufa@gmail.com
SMTP_PASS=
SMTP_FROM=Keneansufa@gmail.com

# Copy to .env and adjust. Everything has a working default for local development.

# --- Database -----------------------------------------------------------------
# Zero-config default (SQLite file in backend/). For Postgres:
#   postgresql+psycopg://kenean:devpassword@localhost:5432/africadata
#   Supabase: postgresql+psycopg://postgres:<password>@db.<project>.supabase.co:5432/postgres
DATABASE_URL=sqlite:///./africadata.db
# Set false in production; Alembic owns the schema there.
AUTO_CREATE_TABLES=true

# --- Cache / rate limiting ----------------------------------------------------
# Leave empty to use the in-process fallback (single instance only).
# Local docker: redis://localhost:6379/0     Upstash: rediss://default:<token>@<host>:6379
REDIS_URL=
CACHE_TTL_SECONDS=3600

# --- App -----------------------------------------------------------------------
ENVIRONMENT=development
SECRET_KEY=change-me-in-production
API_BASE_URL=http://localhost:8000
DOCS_URL=http://localhost:8000/docs
# Comma-separated list, or * for any origin
CORS_ORIGINS=*
# Set false to allow anonymous calls (treated as free tier) during local hacking
REQUIRE_API_KEY=true
LOG_REQUESTS=true
# Enables POST /v1/admin/seed and /v1/admin/scrape (remote data refresh). Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_TOKEN=

# --- Scrapers ------------------------------------------------------------------
SCRAPE_FROM_YEAR=1960
SCRAPE_TO_YEAR=2025
# Optional: UN Data Portal bearer token (MEDIAN_AGE). https://population.un.org/dataportal/about/dataapi
UN_DATA_API_TOKEN=

# --- Email (optional, for key delivery) -----------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
